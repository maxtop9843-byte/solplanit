    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "maplibre-gl": "5.7.1",
    "next": "16.0.10",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.0",
    "eslint": "9.39.1",
    "eslint-config-next": "16.0.1",
    "jsdom": "27.2.0",
    "typescript": "5.9.3",
    "vitest": "4.0.8"
  }
}