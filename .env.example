# Default provider works without a commercial map API key.
NEXT_PUBLIC_MAP_PROVIDER=maplibre

# Optional Kakao integration
NEXT_PUBLIC_KAKAO_MAP_KEY=
KAKAO_REST_API_KEY=

# Optional Naver integration
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=
NAVER_MAP_CLIENT_SECRET=

# Optional AdSense integration. Ads remain disabled until all values are configured,
# the policy-readiness checklist is completed, and the visitor explicitly consents.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_HOME_AFTER_PROCESS=
NEXT_PUBLIC_ADSENSE_SLOT_GUIDES_AFTER_LIST=
# Set exactly to "confirmed" only after the current Google Publisher Policies,
# privacy disclosures, consent/CMP requirements, and production placements are reviewed.
NEXT_PUBLIC_ADSENSE_POLICY_APPROVED=
